#!/usr/bin/env bash
# One-shot setup for a fresh sandbox: dependencies, database, generated assets.
set -euo pipefail

cd "$(dirname "$0")/.."

# Matches the `db` service in .niteshift/services.yaml.
DATABASE_URL="postgresql://umami:umami@localhost:5432/umami"
# Dev-only signing key for a task-local app; its scope dies with the sandbox.
APP_SECRET="niteshift-umami-dev-secret"
# Lets the Niteshift preview panel embed the app (next.config.ts -> frame-ancestors).
ALLOWED_FRAME_URLS="https://niteshift.dev https://*.niteshift.dev"
# `next dev` otherwise blocks /_next requests coming from the preview hostname.
ALLOWED_DEV_ORIGINS="**.preview.niteshift.dev,**.preview.stage.niteshift.dev"

# Umami reads configuration from .env: every script does `import 'dotenv/config'`,
# prisma.config.ts reads it, and `pnpm dev` is `dotenv next dev`. .env is gitignored.
cat > .env <<EOF
DATABASE_URL=${DATABASE_URL}
APP_SECRET=${APP_SECRET}
ALLOWED_FRAME_URLS=${ALLOWED_FRAME_URLS}
ALLOWED_DEV_ORIGINS=${ALLOWED_DEV_ORIGINS}
EOF

pnpm install --frozen-lockfile

# Playwright drives tests/e2e; the lockfile pins the browser revision.
pnpm exec playwright install chromium

# Prisma needs the database before migrations run, so start it ahead of `ns services up`.
ns services start db
for _ in $(seq 1 90); do
  if docker exec umami-postgres pg_isready -U umami -d umami >/dev/null 2>&1; then
    break
  fi
  sleep 1
done
docker exec umami-postgres pg_isready -U umami -d umami

# Prisma client -> src/generated (gitignored).
pnpm build-db
# `prisma migrate deploy`; creates the admin/umami login on a fresh database.
pnpm check-db

# `pnpm build-tracker` also rewrites the tracked src/tracker/index.d.ts, so build
# only the script here and leave the working tree clean.
pnpm build-tracker-script
pnpm build-recorder
# ~65MB download, so only when the GeoIP database is missing.
[ -f geo/GeoLite2-City.mmdb ] || pnpm build-geo

# Browser auth is declared as `auth` on the `web` service in
# .niteshift/services.yaml; Niteshift mints the session itself.
