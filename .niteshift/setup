#!/usr/bin/env bash
# Niteshift one-shot setup: dependencies, database, and dev build artifacts.
set -euo pipefail

cd "$(dirname "$0")/.."

# Dev-only values for a task-local database. The same values are rendered into
# .env by .niteshift/services.yaml, which owns the environment of the services.
export DATABASE_URL="postgresql://umami:umami@localhost:5432/umami"
export APP_SECRET="niteshift-dev-app-secret-not-for-production"

COMPOSE_FILES=(-f docker-compose.yml -f docker-compose.niteshift.yml)

echo "==> Installing dependencies"
pnpm install --frozen-lockfile

echo "==> Installing Playwright browsers"
pnpm exec playwright install chromium

echo "==> Writing docker-compose.niteshift.yml"
# Overrides for the compose database: the supervisor owns the container lifecycle,
# and the dev server runs natively so it needs the database port on the host.
cat > docker-compose.niteshift.yml <<'YAML'
# Generated by .niteshift/setup. Not tracked by git — edit .niteshift/setup instead.
services:
  db:
    restart: "no"
    ports:
      - "127.0.0.1:5432:5432"
YAML
EXCLUDE_FILE="$(git rev-parse --git-path info/exclude)"
mkdir -p "$(dirname "$EXCLUDE_FILE")"
grep -qxF 'docker-compose.niteshift.yml' "$EXCLUDE_FILE" 2>/dev/null ||
  echo 'docker-compose.niteshift.yml' >> "$EXCLUDE_FILE"

echo "==> Starting the database"
ns services start db
for _ in $(seq 1 60); do
  if docker compose "${COMPOSE_FILES[@]}" exec -T db pg_isready -U umami -d umami >/dev/null 2>&1; then
    break
  fi
  sleep 1
done
docker compose "${COMPOSE_FILES[@]}" exec -T db pg_isready -U umami -d umami

echo "==> Generating the Prisma client"
pnpm build-db

echo "==> Applying database migrations"
# Also creates the default admin user (admin / umami) on a fresh database.
pnpm check-db

echo "==> Building the tracker and recorder scripts"
# build-tracker-script only, because build-tracker also regenerates the tracked
# src/tracker/index.d.ts and would leave the working tree dirty.
pnpm build-tracker-script
pnpm build-recorder

echo "==> Downloading the GeoLite2 database"
if [ -f geo/GeoLite2-City.mmdb ]; then
  echo "geo/GeoLite2-City.mmdb already present, skipping."
elif ! pnpm build-geo; then
  echo "WARNING: geo database download failed; location lookups will be unavailable."
fi

echo "==> Seeding demo analytics data"
WEBSITE_COUNT="$(docker compose "${COMPOSE_FILES[@]}" exec -T db \
  psql -U umami -d umami -tAc 'select count(*) from website' | tr -d '[:space:]')"
if [ "$WEBSITE_COUNT" = "0" ]; then
  # Two demo websites with 30 days of sessions, events, and revenue.
  pnpm seed-data
else
  echo "Database already has ${WEBSITE_COUNT} website(s), skipping seed."
fi

echo "==> Setup complete. Sign in at /login with admin / umami."
